# =============================================================================
# Dynamic Risk Trigger Engine — environment configuration
# Copy to .env and adjust. The .env file is gitignored.
# =============================================================================

# --- Database (PostgreSQL only) ----------------------------------------------
# Phase 4 removed the SQLite fallback: the append-only audit trail is enforced
# with PostgreSQL triggers, and silently degrading to SQLite would silently
# degrade that compliance guarantee. A missing Postgres is a hard failure.
DATABASE_URL=postgresql://aml_user:aml_password@localhost:5432/aml_db
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development

# --- Entity resolution & materiality thresholds ------------------------------
# NOTE: the evaluation harness reports precision/recall across a range of fuzzy
# thresholds. On the reference scenario, 65 accepts a customer match for every
# off-book entity; ~85 is the F1 optimum. See the Evaluation view.
FUZZY_MATCH_THRESHOLD=65.0
MATERIALITY_CONFIDENCE_THRESHOLD=65.0
DEDUPLICATION_WINDOW_HOURS=24

# --- Authentication & RBAC ---------------------------------------------------
# Leave JWT_SECRET unset for local development and a random one is generated per
# process, which invalidates tokens on restart. Set it explicitly anywhere that
# matters, and treat it as a secret.
# JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRY_MINUTES=480

# Demo account passwords. These override the documented defaults in
# app/auth.py (analyst123 / manager123 / auditor123).
# DEMO_ANALYST_PASSWORD=
# DEMO_MANAGER_PASSWORD=
# DEMO_AUDITOR_PASSWORD=

# --- Analyst console --------------------------------------------------------
# CORS allowlist. The API carries bearer tokens now, so "*" is no longer safe.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# --- Evaluation harness -----------------------------------------------------
BASELINE_REVIEW_INTERVAL_DAYS=90
EVAL_NUM_CUSTOMERS=1000
EVAL_NUM_EVENTS=5000
EVAL_HORIZON_DAYS=365
EVAL_RANDOM_SEED=42

# --- External API connector keys (optional) ---------------------------------
COMPANIES_HOUSE_API_KEY=your_companies_house_api_key
NEWS_API_KEY=your_news_api_key
OPENSANCTIONS_API_KEY=your_opensanctions_api_key
FCA_API_KEY=your_fca_api_key
FCA_AUTH_EMAIL=compliance@aml-engine.internal

# Live calls default to false so a demo run cannot burn an API quota.
ENABLE_LIVE_API_CALLS=false
MAX_LIVE_API_REQUESTS_PER_RUN=2

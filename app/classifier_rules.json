{
  "categories": {
    "SANCTIONS_MATCH": {
      "default_severity": "CRITICAL",
      "description": "Near-certain — sanctions lists are curated, low false-positive by design",
      "keywords": ["sanction", "ofac", "un_list", "eu_sanctions", "block_list", "specially_designated", "sdn"]
    },
    "REGULATORY_CHANGE": {
      "default_severity": "CRITICAL",
      "description": "FCA licensing, client money (CASS) authorization changes, WealthTek replica",
      "keywords": ["fca", "client_money", "cass", "unauthorized", "license_revoked", "enforcement", "regulatory", "fine", "penalty"]
    },
    "LAW_ENFORCEMENT": {
      "default_severity": "CRITICAL",
